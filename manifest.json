{
    "name": "Chicken Tránlate",
    "version": "1.0",
    "description": "Dịch văn bản đã nhập. Cho mấy con gà sài chứ người pro ai đâu sài ba cái này.",
    "manifest_version": 2,
    "icons": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
  },
    "permissions": [
      "storage"
    ],
    "content_scripts": [
        {
          "matches": ["<all_urls>"],
          "js": ["js/custom.js"]
        }
      ]
  }