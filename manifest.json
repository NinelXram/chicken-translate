
{
  "name": "Chicken Tránlate",
  "version": "2.0",
  "description": "Dịch văn bản đã nhập với giao diện mới",
  "manifest_version": 2,
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "browser_action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/custom.js"],
      "css": ["css/styles.css"]
    }
  ]
}